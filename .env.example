# Supabase (apps/web + services/python)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Flask API
FLASK_API_URL=http://localhost:5000
FLASK_PORT=5000
FLASK_DEBUG=1

# URL pública opcional (solo respaldo en jobs sin petición HTTP).
# Telegram y webhooks NO guardan URL en BD: se toma del host con el que abres la app.
# Dev con ngrok: npm run tunnel (o npm run dev:public), abre la plataforma por la URL https de ngrok.
# Producción: abre la plataforma en tu dominio y pulsa «Registrar webhook»; mismo token y secreto.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# CAPTCHA Solver
CAPTCHA_SOLVER_API_URL=
CAPTCHA_SOLVER_API_KEY=

# IA (E14)
E14_AI_API_KEY=
E14_AI_MODEL=

# CARTO Basemaps (mapa en reportes de campaña)
# Clave publica de cliente para tiles; se envia en la URL del tile desde el navegador.
# Obtener en https://carto.com/basemaps/apikey/
NEXT_PUBLIC_CARTO_API_KEY=
